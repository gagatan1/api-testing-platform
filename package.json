{
  "name": "crm-api-tests",
  "version": "0.1.0",
  "type": "module",
  "description": "API-автотесты CRM (диспетчер / ЛК / мобильное) на supertest + Jest",
  "private": true,
  "scripts": {
    "test": "node --experimental-vm-modules --experimental-require-module node_modules/jest/bin/jest.js",
    "test:smoke": "node --experimental-vm-modules --experimental-require-module node_modules/jest/bin/jest.js --testPathPattern='smoke'",
    "test:watch": "node --experimental-vm-modules --experimental-require-module node_modules/jest/bin/jest.js --watch"
  },
  "devDependencies": {
    "dotenv": "^16.4.5",
    "jest": "^29.7.0",
    "supertest": "^6.3.4"
  }
}